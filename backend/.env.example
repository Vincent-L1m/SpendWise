# ============================================
# SpendWise Backend — Environment Variables
# Salin file ini ke .env dan isi nilainya
# ============================================

# Server
PORT=5000
NODE_ENV=development

# Database MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=spendwise

# JWT Secret — ganti dengan string acak yang panjang!
JWT_SECRET=ganti_ini_dengan_secret_yang_panjang_dan_acak

# Frontend URL (untuk CORS)
FRONTEND_URL=http://localhost:5173

# ── Email OTP (SMTP) ──────────────────────────────────
# Gunakan Gmail App Password atau SMTP provider lain
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# ── SMS OTP via Twilio (Opsional) ─────────────────────
# Daftar di https://www.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890
